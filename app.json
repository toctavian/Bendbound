{
  "expo": {
    "name": "Bendbound",
    "slug": "bendbound",
    "scheme": "bendbound",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/bendbound-logo.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.octavian.bendbound",
      "associatedDomains": [
        "applinks:api.bendboundapp.com"
      ],
      "buildNumber": "8",
      "appleTeamId": "U5CJCX8BV2",
      "usesAppleSignIn": true
    },
    "android": {
      "icon": "./assets/bendbound-logo.png",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/bendbound-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Bendbound to use your location for route planning and ride recording.",
          "locationAlwaysAndWhenInUsePermission": "Allow Bendbound to record your active ride when the app is in the background or your screen is locked. Tracking stops when you pause or finish.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true,
            "usePrecompiledModules": false
          }
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-web-browser",
      "expo-secure-store",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "94d6676b-ff2e-4463-83c7-31aef741ea7c"
      }
    },
    "owner": "toctavian"
  }
}
