{
  "expo": {
    "name": "Bendbound",
    "slug": "bendbound",
    "scheme": "bendbound",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/bendbound-logo.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.octavian.bendbound",
      "buildNumber": "1"
    },
    "android": {
      "icon": "./assets/bendbound-logo.png",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/bendbound-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Bendbound to use your location for route planning and ride recording."
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
