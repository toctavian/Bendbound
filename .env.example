# Leave empty for the legacy public routing provider. Configure the pilot only
# after /health reports ready. On a phone, localhost is the phone, not your Mac.
# Production/TestFlight: use your EC2 HTTPS hostname and rebuild the JS bundle.
# Deployed pilot URL: https://api.bendboundapp.com
EXPO_PUBLIC_ROUTING_URL=
# Shared pilot access only: this value is visible in the app bundle.
# Never use an AWS credential or a production user secret here.
EXPO_PUBLIC_ROUTING_TOKEN=

EXPO_PUBLIC_POI_URL=https://api.bendboundapp.com/pois

EXPO_PUBLIC_FUEL_PRICES_URL=https://api.bendboundapp.com/fuel-prices

# Account prototype: public Cognito identifiers, never a client secret.
# Cognito still issues app sessions; native Apple credentials are exchanged on the server.
EXPO_PUBLIC_AUTH_DOMAIN=
EXPO_PUBLIC_AUTH_CLIENT_ID=
EXPO_PUBLIC_AUTH_USER_POOL_ID=
# Native exchange service origin (HTTPS). Leave empty until the bridge is deployed.
# This is NOT the Cognito domain or the existing session-only API.
EXPO_PUBLIC_NATIVE_APPLE_API_URL=
# Separate authenticated group API. Never reuse the routing pilot token.
EXPO_PUBLIC_GROUP_API_URL=

# Development-only account prototype; keep disabled in release builds until
# deletion, backend revocation, provider setup and device checks are complete.
EXPO_PUBLIC_ACCOUNTS_PREVIEW=false

# Public deletion API endpoint; no secrets.
EXPO_PUBLIC_ACCOUNT_API_URL=

# Private lobby API for group creation/invites (separate from session registration).
EXPO_PUBLIC_GROUP_ROOMS_API_URL=
