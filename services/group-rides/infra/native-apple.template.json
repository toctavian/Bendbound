          "BridgeRole",
          "Arn"
        ]
      }
    },
    "TriggerRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "TriggerRole",
          "Arn"
        ]
      }
    },
    "EnrollmentOperatorFunctionName": {
      "Value": {
        "Ref": "OperatorFunction"
      }
    },
    "AppleGrantTableName": {
      "Value": {
        "Ref": "AppleGrantTable"
      }
    },
    "ProviderCleanupFunctionName": {
      "Value": {
