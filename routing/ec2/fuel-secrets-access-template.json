{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Read-only Fuel Finder secret access for the existing Bendbound EC2 role.",
  "Parameters": {
    "InstanceRoleName": {
      "Type": "String",
      "Description": "IAM role attached to the active EC2 instance profile."
    },
    "SecretArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws:secretsmanager:eu-west-2:[0-9]{12}:secret:.+",
      "Description": "Exact ARN of the Fuel Finder OAuth secret."
    }
  },
  "Resources": {
    "FuelFinderSecretAccess": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "BendboundFuelFinderSecretRead",
        "Roles": [
          {
            "Ref": "InstanceRoleName"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "secretsmanager:GetSecretValue"
              ],
              "Resource": {
                "Ref": "SecretArn"
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "SecretArn": {
      "Value": {
        "Ref": "SecretArn"
      }
    },
    "InstanceRoleName": {
      "Value": {
        "Ref": "InstanceRoleName"
      }
    }
  }
}
